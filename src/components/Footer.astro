---
import { CATEGORIES } from '../data/categories';
import { ALL_TOOLS } from '../data/allTools';

const popularSlugs = [
  'decimal-to-binary',
  'binary-to-decimal',
  'binary-addition-calculator',
  '2s-complement-calculator',
  'ieee-754-converter',
  'bitwise-and-calculator',
  'ascii-to-binary-converter',
  'any-base-to-any-base-converter'
];

const popularTools = ALL_TOOLS.filter((t) => popularSlugs.includes(t.slug));
---

<footer class="bg-[#f5f5f7] dark:bg-[#0c0c0e] text-[#7a7a7a] dark:text-[#8e8e93] text-xs sm:text-sm pt-14 pb-12 border-t border-[#e0e0e0] dark:border-[#2c2c2e] mt-auto transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Footnotes & Disclaimers -->
    <div class="space-y-2 pb-6 border-b border-[#e0e0e0] dark:border-[#2c2c2e] leading-relaxed text-[#7a7a7a] dark:text-[#8e8e93]">
      <p>
        1. Numerical computations on NumForge run locally in the client browser memory space via ECMAScript BigInt and IEEE-754 routines. No telemetry, tracking identifiers, or calculation payloads are transferred to external servers.
      </p>
      <p>
        2. Two's Complement calculations and bitwise operations emulate standard hardware registers (8, 16, 32, and 64 bits). Arithmetic results adhere to ANSI/IEEE Std 754-2019 and ISO/IEC 9899 standards.
      </p>
    </div>

    <!-- 5-Column Directory Columns -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-8 py-4">
      <!-- Col 1: Categories -->
      <div class="space-y-3">
        <h4 class="font-semibold text-xs sm:text-sm text-[#1d1d1f] dark:text-[#f5f5f7] tracking-tight">Core Suites</h4>
        <ul class="space-y-2">
          {CATEGORIES.slice(0, 6).map((cat) => (
            <li>
              <a href={`/tools/${cat.slug}/`} class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/tools/" class="text-[#0066cc] dark:text-[#2997ff] hover:underline font-semibold">
              All 12 Suites &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 2: More Suites -->
      <div class="space-y-3">
        <h4 class="font-semibold text-xs sm:text-sm text-[#1d1d1f] dark:text-[#f5f5f7] tracking-tight">More Categories</h4>
        <ul class="space-y-2">
          {CATEGORIES.slice(6, 12).map((cat) => (
            <li>
              <a href={`/tools/${cat.slug}/`} class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Popular Converters -->
      <div class="space-y-3">
        <h4 class="font-semibold text-xs sm:text-sm text-[#1d1d1f] dark:text-[#f5f5f7] tracking-tight">Popular Tools</h4>
        <ul class="space-y-2">
          {popularTools.slice(0, 6).map((t) => (
            <li>
              <a href={`/${t.slug}/`} class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors truncate block">
                {t.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/tools/" class="text-[#0066cc] dark:text-[#2997ff] hover:underline font-semibold">
              All 137 Tools &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Resources & Guides -->
      <div class="space-y-3">
        <h4 class="font-semibold text-xs sm:text-sm text-[#1d1d1f] dark:text-[#f5f5f7] tracking-tight">Knowledge Base</h4>
        <ul class="space-y-2">
          <li><a href="/learn/" class="text-[#0066cc] dark:text-[#2997ff] font-medium hover:underline">All Learn Articles &rarr;</a></li>
          <li><a href="/learn/what-is-a-number-system/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">What is a Number System?</a></li>
          <li><a href="/learn/how-to-convert-a-decimal-to-binary/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Decimal to Binary Guide</a></li>
          <li><a href="/learn/what-do-you-mean-by-2s-complement/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">2's Complement Explained</a></li>
          <li><a href="/learn/how-is-binary-addition-performed-in-digital-electronics/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Binary Addition Guide</a></li>
        </ul>
      </div>

      <!-- Col 5: Platform Principles -->
      <div class="space-y-3">
        <h4 class="font-semibold text-xs sm:text-sm text-[#1d1d1f] dark:text-[#f5f5f7] tracking-tight">Privacy & Company</h4>
        <ul class="space-y-2">
          <li><a href="/privacy/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Terms of Service</a></li>
          <li><a href="/about/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">About Us</a></li>
          <li><a href="/contact/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Contact Support</a></li>
          <li><a href="/sitemap-index.xml" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-4 border-t border-[#e0e0e0] dark:border-[#2c2c2e] flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-[#7a7a7a] dark:text-[#8e8e93]">
      <div>
        Copyright &copy; {new Date().getFullYear()} NumForge (numforge.online). All rights reserved.
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a href="/privacy/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Privacy</a>
        <span>|</span>
        <a href="/terms/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Terms</a>
        <span>|</span>
        <a href="/about/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">About</a>
        <span>|</span>
        <a href="/contact/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Contact</a>
        <span>|</span>
        <a href="/sitemap-index.xml" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
