---
import Layout from '../layouts/Layout.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': 'Contact NumForge Support & Feedback',
  'url': 'https://numforge.online/contact',
  'description': 'Submit tool requests, report calculation anomalies, or share feedback with the NumForge development team.'
};
---

<Layout
  title="Contact Us — Feedback & Tool Requests | NumForge"
  description="Have a question or request for a new number system tool? Reach out to the NumForge engineering team."
  canonical="https://numforge.online/contact"
  schema={contactSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-12">
    <div class="space-y-3 text-center max-w-xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#f5f5f7] border border-[#e0e0e0] text-[#1d1d1f]">
        <span>Contact</span>
      </div>
      <h1 class="font-display font-semibold text-4xl sm:text-5xl text-[#1d1d1f] tracking-tight">
        Feedback & Support
      </h1>
      <p class="text-base sm:text-lg text-[#7a7a7a]">
        Found an edge case or need a new radix calculator? Send us a message below.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <!-- Left: Form -->
      <div class="md:col-span-7 bg-white border border-[#e0e0e0] rounded-[22px] p-7 sm:p-10 shadow-xs">
        <form id="contact-form" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-semibold uppercase tracking-wider text-[#1d1d1f] mb-1.5">
              Your Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Ada Lovelace"
              class="apple-input w-full text-base py-3"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold uppercase tracking-wider text-[#1d1d1f] mb-1.5">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="ada@example.com"
              class="apple-input w-full text-base py-3"
            />
          </div>

          <div>
            <label for="topic" class="block text-sm font-semibold uppercase tracking-wider text-[#1d1d1f] mb-1.5">
              Subject Topic
            </label>
            <select
              id="topic"
              name="topic"
              class="apple-input w-full text-base py-3"
            >
              <option value="feature">Request New Tool / Radix</option>
              <option value="bug">Report Calculation Discrepancy</option>
              <option value="partnership">Academic / Classroom Citation</option>
              <option value="general">General Feedback</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold uppercase tracking-wider text-[#1d1d1f] mb-1.5">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Describe your request or edge case..."
              class="apple-input w-full text-base py-3"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="apple-btn-primary w-full py-3.5 text-base font-semibold"
          >
            <span>Send Message</span>
          </button>

          <div id="form-success" class="hidden p-4 rounded-xl bg-[#22c55e]/10 border border-[#22c55e]/20 text-[#22c55e] text-sm font-medium text-center">
            Thank you! Your feedback has been received. Our team reviews all suggestions.
          </div>
        </form>
      </div>

      <!-- Right: Direct Info -->
      <div class="md:col-span-5 space-y-5">
        <div class="p-6 rounded-[22px] bg-[#f5f5f7] border border-[#e0e0e0] space-y-2.5">
          <h3 class="font-display font-semibold text-lg sm:text-xl text-[#1d1d1f]">Direct Inquiries</h3>
          <p class="text-sm text-[#7a7a7a]">For formal academic citations and inquiries:</p>
          <a href="mailto:contact@numforge.online" class="inline-block font-mono text-sm sm:text-base font-medium text-[#0066cc] hover:underline">
            contact@numforge.online
          </a>
        </div>

        <div class="p-6 rounded-[22px] bg-white border border-[#e0e0e0] space-y-2.5">
          <h4 class="font-display font-semibold text-sm sm:text-base text-[#1d1d1f]">Reporting Calculation Issues</h4>
          <p class="text-sm text-[#7a7a7a] leading-relaxed">
            Please include the numerical input, expected output per textbook standard (IEEE-754 / ANSI), and observed result.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = 'Sending...';
    }

    setTimeout(() => {
      if (successBox && form && submitBtn) {
        successBox.classList.remove('hidden');
        form.reset();
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = 'Message Sent';
      }
    }, 500);
  });
</script>
