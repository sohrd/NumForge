---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, getToolsByCategory } from '../../data/allTools';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;

if (!category) {
  return Astro.redirect('/404');
}

const tools = getToolsByCategory(category.slug);
const canonicalUrl = `https://numforge.online/tools/${category.slug}/`;

const categorySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#collection`,
      'name': `${category.name} – Free Online Calculators & Converters`,
      'url': canonicalUrl,
      'description': category.longDesc,
      'mainEntity': {
        '@type': 'ItemList',
        'itemListElement': tools.map((t, index) => ({
          '@type': 'ListItem',
          'position': index + 1,
          'name': t.name,
          'url': `https://numforge.online/${t.slug}/`
        }))
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': 'https://numforge.online/'
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'All Tools',
          'item': 'https://numforge.online/tools/'
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': category.name,
          'item': canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={`${category.name} Suite – Calculators & Converters | NumForge`}
  description={category.longDesc}
  canonical={canonicalUrl}
  schema={categorySchema}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    <!-- Breadcrumb Header -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-[#7a7a7a]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#1d1d1f] transition-colors">Home</a>
      <span>/</span>
      <a href="/tools/" class="hover:text-[#1d1d1f] transition-colors">Tools</a>
      <span>/</span>
      <span class="text-[#1d1d1f] font-semibold">{category.name}</span>
    </nav>

    <!-- Category Header Hero -->
    <div class="space-y-4 max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#f5f5f7] border border-[#e0e0e0] text-[#1d1d1f]">
        <span>Category Suite &bull; {tools.length} Tools</span>
      </div>

      <h1 class="font-display font-semibold text-3xl sm:text-5xl lg:text-6xl text-[#1d1d1f] tracking-tight leading-tight">
        {category.name}
      </h1>

      <p class="text-lg sm:text-xl text-[#7a7a7a] leading-relaxed max-w-3xl">
        {category.longDesc}
      </p>
    </div>

    <!-- Quick Search within Category -->
    <div class="relative max-w-md">
      <div class="absolute left-4 top-1/2 -translate-y-1/2 text-[#7a7a7a] pointer-events-none">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="text"
        id="category-search"
        placeholder={`Search ${tools.length} ${category.name.toLowerCase()}...`}
        class="w-full pl-11 pr-4 py-3 rounded-full bg-[#f5f5f7] border border-[#e0e0e0] text-sm text-[#1d1d1f] placeholder-[#7a7a7a] focus:bg-white focus:outline-none focus:border-[#0066cc]"
      />
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="category-tools-grid">
      {tools.map((tool) => (
        <a
          href={`/${tool.slug}/`}
          class="cat-tool-card relative flex flex-col justify-between p-6 rounded-[20px] bg-white border border-[#e0e0e0] hover:border-[#b0b0b5] hover:shadow-xs transition-all duration-200 group"
          data-name={tool.name.toLowerCase()}
          data-desc={tool.shortDesc.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] bg-[#f5f5f7] px-2.5 py-0.5 rounded-md border border-[#e0e0e0]">
                {category.name}
              </span>
              <span class="text-xs text-[#7a7a7a]">0ms</span>
            </div>

            <h2 class="font-display font-semibold text-xl text-[#1d1d1f] group-hover:text-[#0066cc] transition-colors leading-snug mb-2">
              {tool.name}
            </h2>

            <p class="text-sm text-[#7a7a7a] leading-relaxed line-clamp-3 mb-4">
              {tool.shortDesc}
            </p>
          </div>

          <div class="pt-3 border-t border-[#f0f0f0] flex items-center justify-between">
            <span class="text-xs text-[#7a7a7a]">Client-Side BigInt</span>
            <span class="text-xs sm:text-sm font-semibold text-[#0066cc] group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
              Open Tool &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Other Categories Cross-Navigation -->
    <div class="pt-8 border-t border-[#e0e0e0] space-y-4">
      <h3 class="font-display font-semibold text-xl text-[#1d1d1f]">Explore Other Categories</h3>
      <div class="flex flex-wrap gap-2.5">
        {CATEGORIES.filter(c => c.slug !== category.slug).map((c) => (
          <a
            href={`/tools/${c.slug}/`}
            class="px-4 py-2 rounded-full bg-[#f5f5f7] border border-[#e0e0e0] text-xs sm:text-sm font-medium text-[#1d1d1f] hover:border-[#0066cc] hover:text-[#0066cc] transition-all"
          >
            {c.name} &rarr;
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupCategorySearch() {
    const searchInput = document.getElementById('category-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.cat-tool-card') as NodeListOf<HTMLElement>;

    searchInput?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const desc = card.getAttribute('data-desc') || '';
        if (!q || name.includes(q) || desc.includes(q)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }

  setupCategorySearch();
  document.addEventListener('astro:page-load', setupCategorySearch);
</script>
