---
import Layout from '../../layouts/Layout.astro';
import { ARTICLES, type ArticleDefinition } from '../../data/articles';
import { getToolBySlug } from '../../data/allTools';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: ArticleDefinition;
}

const { article } = Astro.props;

if (!article) {
  return Astro.redirect('/404');
}

const canonicalUrl = `https://numforge.online/learn/${article.slug}/`;
const relatedTools = article.relatedToolSlugs
  .map((slug) => getToolBySlug(slug))
  .filter((t): t is NonNullable<typeof t> => !!t);

const otherArticles = ARTICLES.filter((a) => a.slug !== article.slug);

// Structured Data
const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${canonicalUrl}#article`,
      'headline': article.title,
      'description': article.metaDesc,
      'articleSection': article.category,
      'url': canonicalUrl,
      'inLanguage': 'en-US',
      'publisher': {
        '@type': 'Organization',
        'name': 'NumForge',
        'url': 'https://numforge.online'
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': 'https://numforge.online/'
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Learn',
          'item': 'https://numforge.online/learn/'
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': article.title,
          'item': canonicalUrl
        }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      'mainEntity': article.faqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': `<p>${faq.answer}</p>`
        }
      }))
    }
  ]
};
---

<Layout
  title={`${article.metaTitle} | NumForge`}
  description={article.metaDesc}
  canonical={canonicalUrl}
  schema={articleSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    <!-- Breadcrumb Header -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-[#7a7a7a]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#1d1d1f] transition-colors">Home</a>
      <span>/</span>
      <a href="/learn/" class="hover:text-[#1d1d1f] transition-colors">Learn</a>
      <span>/</span>
      <span class="text-[#1d1d1f] font-semibold truncate max-w-xs">{article.title}</span>
    </nav>

    <!-- Article Header -->
    <header class="space-y-4">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#f5f5f7] border border-[#e0e0e0] text-[#1d1d1f]">
          {article.category}
        </span>
        <span class="text-xs text-[#7a7a7a]">
          {article.readTime}
        </span>
      </div>

      <h1 class="font-display font-semibold text-3xl sm:text-5xl lg:text-6xl text-[#1d1d1f] tracking-tight leading-tight">
        {article.title}
      </h1>

      <p class="text-lg sm:text-xl text-[#7a7a7a] leading-relaxed">
        {article.subtitle}
      </p>

      <!-- Executive Summary Box -->
      <div class="p-6 rounded-2xl bg-[#f5f5f7] border border-[#e0e0e0] text-[#1d1d1f] text-base sm:text-lg leading-relaxed space-y-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] block">Overview</span>
        <p>{article.summary}</p>
      </div>
    </header>

    <!-- Main Content Flow -->
    <div class="space-y-12 text-[#333333] text-base sm:text-lg leading-relaxed">
      <!-- Section 1: Concept Definition -->
      <section class="space-y-3">
        <h2 class="font-display font-semibold text-2xl sm:text-3xl text-[#1d1d1f] tracking-tight">
          1. Understanding the Core Concept
        </h2>
        <p>{article.whatIs}</p>
      </section>

      <!-- Section 2: Methodology -->
      <section class="space-y-3">
        <h2 class="font-display font-semibold text-2xl sm:text-3xl text-[#1d1d1f] tracking-tight">
          2. How Does It Work? Step-by-Step Methodology
        </h2>
        <p class="whitespace-pre-line">{article.howItWorks}</p>
      </section>

      <!-- Section 3: Mathematical Formula / Algorithm -->
      <section class="p-6 sm:p-8 rounded-[22px] bg-white border border-[#e0e0e0] space-y-4 shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc]">Mathematical Algorithm</span>
          <span class="text-xs font-mono text-[#7a7a7a]">Formal Method</span>
        </div>
        <div class="p-5 rounded-xl bg-[#f5f5f7] border border-[#e0e0e0] font-mono text-xs sm:text-sm text-[#1d1d1f] overflow-x-auto whitespace-pre-wrap">
          {article.formula}
        </div>
      </section>

      <!-- Section 4: Worked Problem & Proof -->
      <section class="p-6 sm:p-8 rounded-[22px] bg-[#f5f5f7] border border-[#e0e0e0] space-y-4">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] block">Worked Problem</span>
        <h2 class="font-display font-semibold text-2xl sm:text-3xl text-[#1d1d1f] tracking-tight">
          3. Detailed Worked Example & Verification
        </h2>
        <div class="p-5 rounded-xl bg-white border border-[#e0e0e0] font-mono text-xs sm:text-sm text-[#1d1d1f] overflow-x-auto whitespace-pre-wrap leading-relaxed">
          {article.stepByStepExample}
        </div>
      </section>

      <!-- Section 5: Important Rules -->
      <section class="space-y-4">
        <h2 class="font-display font-semibold text-2xl sm:text-3xl text-[#1d1d1f] tracking-tight">
          4. Essential Rules & Edge Cases
        </h2>
        <ul class="list-disc pl-6 space-y-2.5 text-[#333333]">
          {article.rules.map((rule) => (
            <li><strong>{rule}</strong></li>
          ))}
        </ul>
      </section>

      <!-- Section 6: Practical Applications -->
      <section class="space-y-4">
        <h2 class="font-display font-semibold text-2xl sm:text-3xl text-[#1d1d1f] tracking-tight">
          5. Practical Engineering Applications
        </h2>
        <ul class="list-disc pl-6 space-y-2.5 text-[#7a7a7a]">
          {article.applications.map((app) => (
            <li><span class="text-[#1d1d1f]">{app}</span></li>
          ))}
        </ul>
      </section>

      <!-- Section 7: Common Mistakes -->
      <section class="p-6 sm:p-8 rounded-[22px] bg-white border border-[#e0e0e0] space-y-4">
        <h2 class="font-display font-semibold text-2xl sm:text-3xl text-[#1d1d1f] tracking-tight">
          6. Common Mistakes to Avoid
        </h2>
        <ul class="space-y-2.5 text-sm sm:text-base">
          {article.mistakes.map((mistake) => (
            <li class="flex items-start gap-2.5">
              <span class="px-2 py-0.5 rounded text-xs font-bold bg-[#ff3b30]/10 text-[#ff3b30] shrink-0 mt-0.5">Warning</span>
              <span class="text-[#333333]">{mistake}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Section 8: Interactive NumForge Calculators -->
      {relatedTools.length > 0 && (
        <section class="p-7 sm:p-8 rounded-[24px] bg-[#1d1d1f] text-white space-y-6">
          <div class="space-y-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-[#2997ff] block">Interactive Verification</span>
            <h3 class="font-display font-semibold text-2xl sm:text-3xl text-white">
              Try It in Your Browser (0ms Latency)
            </h3>
            <p class="text-sm sm:text-base text-[#cccccc]">
              Validate these formulas instantly with NumForge's deterministic hardware-grade online tools.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedTools.map((t) => (
              <a
                href={`/${t.slug}/`}
                class="p-4 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 transition-all flex flex-col justify-between group"
              >
                <div>
                  <div class="text-xs text-[#2997ff] font-mono mb-1">{t.categoryName}</div>
                  <div class="font-semibold text-base text-white group-hover:text-[#2997ff] transition-colors">{t.name}</div>
                  <div class="text-xs text-[#cccccc] line-clamp-2 mt-1">{t.shortDesc}</div>
                </div>
                <div class="pt-3 mt-2 border-t border-white/10 text-xs font-medium text-[#2997ff] flex items-center justify-between">
                  <span>Open Tool</span>
                  <span>&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Section 9: FAQ Section -->
      <section class="space-y-6 pt-4">
        <div class="space-y-1">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] block">FAQ</span>
          <h2 class="font-display font-semibold text-2xl sm:text-3xl text-[#1d1d1f] tracking-tight">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="space-y-3">
          {article.faqs.map((faq) => (
            <details class="group bg-[#f5f5f7] border border-[#e0e0e0] rounded-2xl overflow-hidden hover:border-[#b0b0b5] transition-colors">
              <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none select-none font-display font-medium text-base sm:text-lg text-[#1d1d1f]">
                <span>{faq.question}</span>
                <span class="w-6 h-6 rounded-full bg-white flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform duration-200">
                  <svg class="w-3.5 h-3.5 text-[#7a7a7a]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="px-5 pb-5 text-[#7a7a7a] text-sm sm:text-base leading-relaxed border-t border-[#e0e0e0] pt-3">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- Section 10: More Articles -->
      <section class="pt-8 border-t border-[#e0e0e0] space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="font-display font-semibold text-2xl text-[#1d1d1f]">More Learning Guides</h3>
          <a href="/learn/" class="text-xs sm:text-sm font-semibold text-[#0066cc] hover:underline">
            View All {ARTICLES.length} Guides &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {otherArticles.slice(0, 4).map((other) => (
            <a
              href={`/learn/${other.slug}/`}
              class="p-5 rounded-2xl bg-white border border-[#e0e0e0] hover:border-[#b0b0b5] hover:shadow-xs transition-all flex flex-col justify-between group"
            >
              <div>
                <span class="text-xs text-[#0066cc] font-medium">{other.category}</span>
                <h4 class="font-display font-semibold text-base sm:text-lg text-[#1d1d1f] group-hover:text-[#0066cc] transition-colors mt-1 mb-1">
                  {other.title}
                </h4>
                <p class="text-xs sm:text-sm text-[#7a7a7a] line-clamp-2">{other.summary}</p>
              </div>
              <span class="text-xs font-semibold text-[#0066cc] mt-3 flex items-center gap-1">
                Read Article &rarr;
              </span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>
